<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 4x1. Solo widgets del sistema (RemoteViews no admite otros) y sin
  AndroidX: LinearLayout, ImageView, TextView, ImageButton y ProgressBar.
  El id `widget_root` es el que abre la app; los demás van al servicio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/widget_art"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF6FBFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3A9B8D6"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:progressTint="#FF2DA6" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_previous"
        android:src="@android:drawable/ic_media_previous" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_toggle"
        android:src="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_next"
        android:src="@android:drawable/ic_media_next" />
</LinearLayout>
