<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Biblioteca local de audio (el motor sabe escanear carpetas). En Android 13+
      basta READ_MEDIA_AUDIO; hasta Android 12 hacía falta READ_EXTERNAL_STORAGE.
      Si el usuario abre archivos con el selector del sistema, no hace falta
      ninguno de los dos.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Para que el audio no se corte con la pantalla apagada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Reproducción en segundo plano: MediaSessionService es un servicio en
      primer plano de tipo mediaPlayback (pantalla apagada, app minimizada,
      pantalla de bloqueo). Desde Android 14 el tipo exige su propio permiso
      FOREGROUND_SERVICE_MEDIA_PLAYBACK; desde Android 13 POST_NOTIFICATIONS se
      pide en runtime (MainActivity) para que se vea la notificación.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Auto-play al conectar auriculares Bluetooth: desde Android 12 el sistema
      solo entrega BluetoothDevice.ACTION_ACL_CONNECTED con este permiso. No se
      pide en runtime: si el usuario no lo concede, el auto-play por Bluetooth
      simplemente no ocurre (el de la clavija de 3,5 mm no lo necesita).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      CyberHexApplication cachea el FlutterEngine (y con él el isolate de Dart y
      el motor de audio) para que cerrar la app desde "Recientes" no corte la
      reproducción. MainActivity reutiliza ese motor y no lo destruye.
    -->
    <application
        android:label="CyberHex"
        android:name=".CyberHexApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Abrir un audio desde fuera: explorador de archivos, WhatsApp,
              "Compartir con..." o un enlace content://. MainActivity copia el
              content:// a cacheDir/shared_audio (el núcleo necesita una ruta
              POSIX) y se lo pasa a Dart por el canal cyberhex/intent.
              launchMode="singleTop" ya está puesto: un segundo archivo llega
              por onNewIntent en vez de crear otra actividad.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="audio/*"/>
                <data android:scheme="file" android:mimeType="audio/*"/>
            </intent-filter>
        </activity>
        <!--
          Widget de la pantalla de inicio, 4x1 y 4x2. Dos <receiver> porque
          Android identifica cada widget por su clase; los dos pintan el mismo
          PlaybackCache y sus botones son PendingIntent al servicio.
          exported="false": los actualiza el sistema, nadie más.
        -->
        <receiver
            android:name=".CyberHexWidgetProvider"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver
            android:name=".CyberHexWidgetLargeProvider"
            android:exported="false"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <!--
          Azulejo de ajustes rápidos (API 24+). BIND_QUICK_SETTINGS_TILE lo
          exige el sistema: solo él puede enlazarlo.
        -->
        <service
            android:name=".CyberHexTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_play"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Fuente de audio para Android Auto / coches: MediaBrowserService del
          sistema (sin AndroidX). El transporte lo aporta la MediaSession del
          MediaSessionService.
        -->
        <service
            android:name=".CyberHexBrowserService"
            android:exported="true"
            android:permission="android.permission.BIND_MEDIA_BROWSER_SERVICE">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Motor de reproducción: mantiene el proceso en primer plano mientras
          suena audio, publica la MediaSession y reenvía los botones (casco,
          pantalla de bloqueo, notificación) al motor de Dart.
          stopWithTask="false": quitar la tarea de Recientes no mata el
          servicio; la reproducción se cierra deslizando la notificación en
          pausa o desde los controles.
        -->
        <service
            android:name=".MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
        <!-- Android Auto: sin esta declaración el coche no lista a CyberHex. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
