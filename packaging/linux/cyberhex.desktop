[Desktop Entry]
Type=Application
Name=CyberHex
GenericName=Reproductor de audio
Comment=Reproductor con motor nativo en Zig y C23
# %U = lista de URIs con la que el gestor de archivos abre un audio.
Exec=cyberhex %U
Icon=cyberhex
Terminal=false
Categories=AudioVideo;Audio;Player;GTK;
Keywords=audio;musica;player;flac;mp3;
StartupNotify=true
StartupWMClass=cyberhex
MimeType=audio/mpeg;audio/x-mpeg;audio/mp3;audio/flac;audio/x-flac;audio/ogg;audio/vorbis;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-ape;audio/wavpack;
